{
  "manifest_version": 3,
  "name": "Saint Expeditus Bot",
  "version": "1.0.0",
  "description": "Community assistant bot for SAINT EXPEDITUS SUBDIVISION Messenger group chat",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.messenger.com/*", "http://localhost:3141/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.messenger.com/*"],
      "js": ["dist/main.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Saint Expeditus Bot"
  },
  "icons": {}
}
